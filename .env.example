PORT=3001
APP_ORIGIN=http://localhost:5173
# Development preview uses a separate database and never enables in production.
ADMIN_DEMO=false
DATABASE_PATH=.data/aion.sqlite
# Required in production: generate at least 32 random characters.
SESSION_SECRET=
# Optional HTTPS transactional email webhook (server-side bearer credential).
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Active product SKU used by the existing storefront reservation form.
PREORDER_PRODUCT_SKU=AION-FOUNDER
