{
  "name": "jcringforlife",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "build": "npm run build:frontend && npm run build:admin",
    "preview": "vite preview --config frontend/vite.config.js",
    "dev:storefront": "vite --config frontend/vite.config.js",
    "start": "node backend/api/src/index.js",
    "lint": "eslint backend tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "admin:create": "node backend/api/src/create-admin.js",
    "catalog:init": "node backend/api/src/init-catalog.js",
    "dev:api": "concurrently -k \"node --watch backend/api/src/index.js\" \"vite --config frontend/vite.config.js --mode api\"",
    "dev:admin": "vite --config backend/admin/vite.config.js",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "build:admin": "vite build --config backend/admin/vite.config.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "framer-motion": "^11.11.17",
    "gsap": "^3.12.5",
    "helmet": "^8.1.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.3.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "postcss": "^8.4.47",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.14",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
